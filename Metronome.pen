              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "m5YdR",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Metronome is designed with your privacy in mind. Its practice features work offline, and it does not require an account or personal information to use. The app does send anonymous diagnostic data, described below.",
              "lineHeight": 1.625,
              "fontFamily": "$mt-font",
              "fontSize": 16
            },
            {
              "type": "text",
              "id": "ldKRR",
              "name": "Policy section / Data We Collect",
              "fill": "$mt-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Data We Collect",
              "lineHeight": 1.2,
              "fontFamily": "$mt-font",
              "fontSize": 24,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "IQV9B",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The app uses the following third-party services:",
              "lineHeight": 1.625,
              "fontFamily": "$mt-font",
              "fontSize": 16
            },
            {
              "type": "text",
              "id": "txXIM",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Firebase Crashlytics (iPhone, iPad and Android) — collects anonymous crash reports to help us fix bugs. This includes device type, OS version, and stack traces. No personal data is included.",
              "lineHeight": 1.625,
              "fontFamily": "$mt-font",
              "fontSize": 16
            },
            {
              "type": "text",
              "id": "o11wIH",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Firebase Analytics (Android only) — collects anonymous usage data such as session duration and screen views. This helps us understand how the app is used and improve it.",
              "lineHeight": 1.625,
              "fontFamily": "$mt-font",
              "fontSize": 16
            },
            {
              "type": "text",
              "id": "E3wT9I",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "• Firebase Performance Monitoring (Android only) — collects anonymous performance metrics to help us optimize the app.",
              "lineHeight": 1.625,
              "fontFamily": "$mt-font",
              "fontSize": 16
            },
            {
              "type": "text",
              "id": "EBmDv",
              "name": "Policy section / Data Stored on Your Device",
              "fill": "$mt-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Data Stored on Your Device",
              "lineHeight": 1.2,
              "fontFamily": "$mt-font",
              "fontSize": 24,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "McaSj",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Your settings (tempo, sound, theme, practice time) are stored locally on your device using DataStore. This data never leaves your device.",
              "lineHeight": 1.625,
              "fontFamily": "$mt-font",
              "fontSize": 16
            },
            {
              "type": "text",
              "id": "GeDEw",
              "name": "Policy section / No Personal Data",
              "fill": "$mt-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "No Personal Data",
              "lineHeight": 1.2,
              "fontFamily": "$mt-font",
              "fontSize": 24,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "L7rhih",
              "name": "Policy paragraph",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "We do not collect, store, or share any personally identifiable information. We do not require registration, login, or any personal details.",
