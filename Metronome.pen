          "name": "Number specification",
          "width": "fill_container",
          "fill": "$mt-container",
          "cornerRadius": 16,
          "layout": "vertical",
          "gap": 12,
          "padding": 22,
          "children": [
            {
              "type": "text",
              "id": "Tx4cw",
              "name": "Value example",
              "fill": "$mt-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "80 → 81",
              "lineHeight": 1.35,
              "fontFamily": "$mt-font",
              "fontSize": 46,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "kPYBK",
              "name": "Changed digits",
              "fill": "$mt-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "8 stays still. Only 0 → 1 rolls through the 24 px distance. Use two bounded slots per decimal place; retain visible progress on reversal.",
              "lineHeight": 1.35,
              "fontFamily": "$mt-font",
              "fontSize": 15
            },
            {
              "type": "text",
              "id": "U6WBKp",
              "name": "Interruption",
              "fill": "$mt-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Never queue outgoing labels. Retarget the current motion. Reused hidden slots enter from the current direction. The current value alone sizes and centers the readout.",
              "lineHeight": 1.35,
              "fontFamily": "$mt-font",
              "fontSize": 14
            }
          ]
        },
        {
          "type": "text",
          "id": "ZabrJ",
          "name": "Coordinated settings",
          "fill": "$mt-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Disclosures: height, opacity and 12 px inner lift share Emphasized. Switch: fill and thumb share Standard. Palette: Calm semantic colours + Emphasized ring. Appearance: readable reveal; no grey-on-grey blend.",
          "lineHeight": 1.35,
          "fontFamily": "$mt-font",
          "fontSize": 15
        },
        {
          "type": "text",
          "id": "o3UGmS",
          "name": "Slider specification",
          "fill": "$mt-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "56 px native hit area. Immediate pointer position; Standard for keyboard/programmatic selection; Press grip, Quick value hint. Transform-only fill and grip. Number changes animate only changed digits.",
          "lineHeight": 1.35,
          "fontFamily": "$mt-font",
          "fontSize": 15
        },
        {
          "type": "text",
          "id": "o5l6e",
          "name": "Reduced motion",
          "fill": "$mt-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Apply spatial state, theme, number and disclosure height immediately. Short 120 ms opacity feedback is allowed for text/icons. No translation, rotation, scale pulse or selection travel.",
          "lineHeight": 1.35,
          "fontFamily": "$mt-font",
          "fontSize": 15,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "O7La6K",
          "name": "Implementation reference",
          "fill": "$mt-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Static frames specify states. The local web preview demonstrates the current motion. Native timing, accessibility, audio and physical-device feel require app acceptance.",
          "lineHeight": 1.35,
          "fontFamily": "$mt-font",
          "fontSize": 13
        }
      ]
    },
